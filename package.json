{
  "name": "faro-lease-ledger",
  "version": "1.0.0",
  "description": "Rental lease billing, partial payment tracking, and receipt reconciliation engine.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "lease-management",
    "billing-engine",
    "payment-reconciliation",
    "typescript",
    "express",
    "sqlite"
  ],
  "author": "David Machado <avidmachado@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.0.6",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
